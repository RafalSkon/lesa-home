<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LeSa Sync — SeoHost Synchronizer"
        Width="1140" Height="760" MinWidth="950" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="#0B0F19" Foreground="#F1F5F9"
        FontFamily="Segoe UI Variable Display, Segoe UI, sans-serif">
    
    <Window.Resources>
        <Style TargetType="Button" x:Key="NavBtn">
            <Setter Property="Background" Value="#1E293B" />
            <Setter Property="Foreground" Value="#F1F5F9" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="12,7,12,7" />
            <Setter Property="Margin" Value="4,0,4,0" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style TargetType="TextBox" x:Key="FormInput">
            <Setter Property="Background" Value="#1E293B" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#334155" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Height" Value="36" />
            <Setter Property="Padding" Value="10,6,10,6" />
            <Setter Property="Margin" Value="0,0,0,16" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="68" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <Border Grid.Row="0" Background="#111827" BorderBrush="#1F2937" BorderThickness="0,0,0,1" Padding="20,0,20,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Brand -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="38" Height="38" CornerRadius="10" Background="#0F172A" BorderBrush="#EA580C" BorderThickness="1.5" Margin="0,0,14,0">
                        <TextBlock Text="⚡" FontSize="18" Foreground="#F97316" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="LeSa Sync" FontSize="19" FontWeight="Bold" Foreground="#FFFFFF" />
                        <TextBlock Name="txtProjectSub" Text="SeoHost Live Deploy • c:\LeSa.start" FontSize="11" Foreground="#64748B" Margin="0,2,0,0" />
                    </StackPanel>
                </StackPanel>

                <!-- Center Status Pill -->
                <Border Grid.Column="1" Name="borderStatusPill" Background="#0F172A" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="14" Padding="14,6,14,6" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse Name="dotStatus" Width="8" Height="8" Fill="#10B981" Margin="0,0,8,0" VerticalAlignment="Center" />
                        <TextBlock Name="txtStatusPill" Text="Połączono z SeoHost" FontSize="12" FontWeight="SemiBold" Foreground="#34D399" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>

                <!-- Navigation Buttons -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Name="btnRefresh" Content="🔄 Odśwież (F5)" Style="{StaticResource NavBtn}" />
                    <Button Name="btnToggleLog" Content="📋 Dziennik" Style="{StaticResource NavBtn}" Foreground="#94A3B8" />
                    <Button Name="btnSettings" Content="⚙ Ustawienia" Style="{StaticResource NavBtn}" Foreground="#38BDF8" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- MAIN VIEW (2 COLUMNS: FOLDERS + FILES) -->
        <Grid Grid.Row="1" Name="gridMainView">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280" MinWidth="220" MaxWidth="380" />
                <ColumnDefinition Width="1" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- LEFT PANEL: FOLDERS / KATALOGI -->
            <Border Grid.Column="0" Background="#0E1422" BorderBrush="#1F2937" BorderThickness="0,0,1,0" Padding="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="0,0,0,12">
                        <TextBlock Text="KATALOGI PROJEKTU" FontSize="11" FontWeight="Bold" Foreground="#64748B" Margin="4,0,0,4" />
                        <TextBlock Text="Wybierz folder lub zobacz wszystkie zmiany" FontSize="10" Foreground="#475569" Margin="4,0,0,0" />
                    </StackPanel>

                    <!-- Folders List -->
                    <ListView Grid.Row="1" Name="listFolders" Background="Transparent" BorderThickness="0" Foreground="#FFFFFF" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{Binding ItemBg}" BorderBrush="{Binding ItemBorder}" BorderThickness="1" CornerRadius="8" Margin="0,2,0,2" Padding="10,8,10,8" Cursor="Hand">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0" Text="{Binding IconGlyph}" FontSize="15" Margin="0,0,10,0" VerticalAlignment="Center" />

                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding DisplayName}" Foreground="#F8FAFC" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding FileCountText}" Foreground="#64748B" FontSize="10" />
                                        </StackPanel>

                                        <Border Grid.Column="2" Background="{Binding BadgeBg}" CornerRadius="10" Padding="7,2,7,2" VerticalAlignment="Center" Visibility="{Binding BadgeVisibility}">
                                            <TextBlock Text="{Binding BadgeText}" Foreground="{Binding BadgeFg}" FontSize="10" FontWeight="Bold" />
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>

            <!-- SPLITTER BORDER -->
            <Border Grid.Column="1" Background="#1F2937" />

            <!-- RIGHT PANEL: FILES IN SELECTED FOLDER -->
            <Grid Grid.Column="2" Margin="20,16,20,16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Search and Filters Bar -->
                <Grid Grid.Row="0" Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Search Box -->
                    <Border Grid.Column="0" Background="#161F30" BorderBrush="#334155" BorderThickness="1" CornerRadius="8" Padding="10,4,10,4" Margin="0,0,14,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="🔍" FontSize="13" Foreground="#94A3B8" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBox Grid.Column="1" Name="txtSearch" Background="Transparent" Foreground="#FFFFFF" BorderThickness="0" FontSize="13" VerticalAlignment="Center" />
                            <Button Grid.Column="2" Name="btnClearSearch" Content="✕" Background="Transparent" Foreground="#64748B" BorderThickness="0" Cursor="Hand" Visibility="Collapsed" />
                        </Grid>
                    </Border>

                    <!-- Mode Filters -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <RadioButton Name="rbOnlyChanged" Content="⚡ Tylko zmienione" IsChecked="True" Foreground="#CBD5E1" FontSize="12" FontWeight="SemiBold" Margin="0,0,16,0" VerticalAlignment="Center" />
                        <RadioButton Name="rbAllFiles" Content="📂 Wszystkie pliki" Foreground="#CBD5E1" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </StackPanel>
                </Grid>

                <!-- Action Bar -->
                <Grid Grid.Row="1" Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <CheckBox Name="chkSelectAll" Content="Zaznacz wszystkie w widoku" IsChecked="True" Foreground="#E2E8F0" FontSize="13" VerticalAlignment="Center" Margin="0,0,18,0" />
                        <TextBlock Name="txtFolderTitle" Text="Katalog: Wszystkie zmienione (0)" Foreground="#38BDF8" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,12,0" />
                        <TextBlock Name="txtSummary" Text="| Zaznaczono: 0" Foreground="#94A3B8" FontSize="13" VerticalAlignment="Center" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Name="btnResetState" Content="↺ Resetuj stan (wszystko aktualne)" Style="{StaticResource NavBtn}" Foreground="#FBBF24" Margin="0,0,10,0" ToolTip="Oznacza wszystkie pliki jako zsynchronizowane z serwerem" />
                        <Button Name="btnSendSelected" Content="⚡ WYŚLIJ ZAZNACZONE NA SEOHOST" FontSize="13" FontWeight="Bold" Padding="20,10,20,10" Background="#10B981" Foreground="#FFFFFF" BorderThickness="0" Cursor="Hand" />
                    </StackPanel>
                </Grid>

                <!-- Progress Bar and Notifications Area -->
                <StackPanel Grid.Row="2" Margin="0,0,0,12">
                    <!-- Progress Bar -->
                    <StackPanel Name="panelProgress" Margin="0,0,0,10" Visibility="Collapsed">
                        <ProgressBar Name="pbUpload" Height="8" Background="#1E293B" Foreground="#10B981" BorderThickness="0" />
                        <TextBlock Name="txtProgressInfo" Text="Wysyłanie plików..." FontSize="12" Foreground="#38BDF8" Margin="0,6,0,0" />
                    </StackPanel>

                    <!-- Notification Toast Banner -->
                    <Border Name="bannerNotification" CornerRadius="8" Background="#064E3B" BorderBrush="#059669" BorderThickness="1" Padding="14,10,14,10" Margin="0,0,0,4" Visibility="Collapsed">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Name="iconNotification" Grid.Column="0" Text="✔" FontSize="16" FontWeight="Bold" Foreground="#34D399" Margin="0,0,10,0" VerticalAlignment="Center" />
                            <TextBlock Name="txtNotification" Grid.Column="1" Text="Pomyślnie wysłano pliki na SeoHost!" FontSize="13" FontWeight="SemiBold" Foreground="#E6FFFA" VerticalAlignment="Center" TextWrapping="Wrap" />
                            <Button Name="btnCloseNotification" Grid.Column="2" Content="✕" Background="Transparent" Foreground="#6EE7B7" BorderThickness="0" Cursor="Hand" Padding="6,2,6,2" FontSize="12" VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                </StackPanel>

                <!-- File Cards ListView -->
                <ListView Grid.Row="3" Name="listFiles" Background="#111827" BorderBrush="#1F2937" BorderThickness="1" Foreground="#FFFFFF" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Border Background="#161F30" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="8" Margin="0,3,0,3" Padding="14,10,14,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Checkbox -->
                                    <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected, Mode=TwoWay}" VerticalAlignment="Center" Margin="0,0,14,0" />

                                    <!-- Extension Pill -->
                                    <Border Grid.Column="1" Background="{Binding ExtBg}" CornerRadius="4" Padding="7,3,7,3" Margin="0,0,14,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding ExtBadge}" Foreground="{Binding ExtFg}" FontSize="11" FontWeight="Bold" />
                                    </Border>

                                    <!-- File Name & Path -->
                                    <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="0,0,14,0">
                                        <TextBlock Text="{Binding FileName}" Foreground="#F8FAFC" FontSize="14" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding RelativePath}" Foreground="#64748B" FontSize="11" Margin="0,2,0,0" />
                                    </StackPanel>

                                    <!-- Change Status Badge -->
                                    <Border Grid.Column="3" Background="{Binding ChangeTypeBg}" CornerRadius="10" Padding="10,3,10,3" Margin="0,0,16,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding ChangeTypeText}" Foreground="{Binding ChangeTypeFg}" FontSize="11" FontWeight="Bold" />
                                    </Border>

                                    <!-- Timestamp & Size (Swapped: Time on top, larger font) -->
                                    <StackPanel Grid.Column="4" VerticalAlignment="Center" Margin="0,0,20,0" HorizontalAlignment="Right">
                                        <TextBlock Text="{Binding ModifiedTimeText}" Foreground="#F8FAFC" FontSize="14" FontWeight="Bold" HorizontalAlignment="Right" />
                                        <TextBlock Text="{Binding FileSizeText}" Foreground="#94A3B8" FontSize="11" Margin="0,2,0,0" HorizontalAlignment="Right" />
                                    </StackPanel>

                                    <!-- Live Upload Status -->
                                    <TextBlock Grid.Column="5" Text="{Binding StatusText}" Foreground="{Binding StatusColor}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,16,0" />

                                    <!-- Single Upload Button -->
                                    <Button Grid.Column="6" Content="⚡ Wyślij" Tag="{Binding}" Background="#1E293B" Foreground="#38BDF8" FontWeight="SemiBold" FontSize="12" BorderThickness="1" BorderBrush="#0284C7" Padding="12,6,12,6" Cursor="Hand" VerticalAlignment="Center" ToolTip="Wyślij tylko ten plik na SeoHost" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Grid>

        <!-- SETTINGS VIEW -->
        <Grid Grid.Row="1" Name="gridSettingsView" Margin="32" Visibility="Collapsed">
            <Border Background="#111827" BorderBrush="#1F2937" BorderThickness="1" CornerRadius="12" Padding="32" MaxWidth="720" HorizontalAlignment="Center" VerticalAlignment="Top">
                <StackPanel>
                    <TextBlock Text="⚙ Konfiguracja połączenia z SeoHost" FontSize="18" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,0,0,6" />
                    <TextBlock Text="Wprowadź dane dostępowe do konta FTP ze swojego panelu hostingu w SeoHost." FontSize="13" Foreground="#94A3B8" Margin="0,0,0,24" />

                    <TextBlock Text="Serwer / Host FTP (np. sXX.seohost.pl lub twojadomena.pl):" FontSize="12" FontWeight="SemiBold" Foreground="#CBD5E1" Margin="0,0,0,6" />
                    <TextBox Name="txtSetHost" Style="{StaticResource FormInput}" />

                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Port (Domyślnie 21):" FontSize="12" FontWeight="SemiBold" Foreground="#CBD5E1" Margin="0,0,0,6" />
                            <TextBox Name="txtSetPort" Text="21" Style="{StaticResource FormInput}" Margin="0" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Protokół szyfrowania:" FontSize="12" FontWeight="SemiBold" Foreground="#CBD5E1" Margin="0,0,0,6" />
                            <ComboBox Name="cmbProtocol" Background="#1E293B" Foreground="#FFFFFF" Height="36" Padding="8,6,8,6">
                                <ComboBoxItem Content="FTPS (FTP over TLS/SSL - Bezpieczny, Zalecany)" IsSelected="True" />
                                <ComboBoxItem Content="FTP (Standardowy bez szyfrowania)" />
                            </ComboBox>
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="Użytkownik / Login FTP:" FontSize="12" FontWeight="SemiBold" Foreground="#CBD5E1" Margin="0,0,0,6" />
                    <TextBox Name="txtSetUser" Style="{StaticResource FormInput}" />

                    <TextBlock Text="Hasło FTP:" FontSize="12" FontWeight="SemiBold" Foreground="#CBD5E1" Margin="0,0,0,6" />
                    <PasswordBox Name="txtSetPass" Background="#1E293B" Foreground="#FFFFFF" BorderBrush="#334155" BorderThickness="1" Height="36" Padding="10,6,10,6" Margin="0,0,0,16" />

                    <TextBlock Text="Katalog zdalny na serwerze (np. /public_html lub /domains/twojadomena.pl/public_html):" FontSize="12" FontWeight="SemiBold" Foreground="#CBD5E1" Margin="0,0,0,6" />
                    <TextBox Name="txtSetRemote" Text="/public_html" Style="{StaticResource FormInput}" />

                    <!-- Test Banner -->
                    <Border Name="bannerTestResult" CornerRadius="6" Padding="14,10,14,10" Margin="0,8,0,16" Visibility="Collapsed">
                        <TextBlock Name="txtTestBanner" FontSize="12" TextWrapping="Wrap" />
                    </Border>

                    <!-- Settings Actions -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                        <Button Name="btnTestConnection" Content="⚡ Testuj połączenie" Style="{StaticResource NavBtn}" Foreground="#38BDF8" />
                        <Button Name="btnSaveSettings" Content="💾 Zapisz konfigurację" FontSize="13" FontWeight="Bold" Padding="20,10,20,10" Background="#10B981" Foreground="#FFFFFF" BorderThickness="0" Margin="10,0,10,0" Cursor="Hand" />
                        <Button Name="btnCancelSettings" Content="Wróć do plików" Style="{StaticResource NavBtn}" Foreground="#94A3B8" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- LOG DRAWER -->
        <Border Grid.Row="2" Name="drawerLogs" Background="#050811" BorderBrush="#1F2937" BorderThickness="0,1,0,0" Height="170" Visibility="Collapsed">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="#0B0F19" Padding="16,6,16,6">
                    <Grid>
                        <TextBlock Text="DZIENNIK ZDARZEŃ I TRANSFERU" FontSize="11" FontWeight="Bold" Foreground="#64748B" VerticalAlignment="Center" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Name="btnClearLog" Content="Wyczyść" Background="Transparent" Foreground="#94A3B8" BorderThickness="0" Margin="0,0,10,0" Cursor="Hand" />
                            <Button Name="btnCloseLog" Content="✕ Zamknij" Background="Transparent" Foreground="#94A3B8" BorderThickness="0" Cursor="Hand" />
                        </StackPanel>
                    </Grid>
                </Border>

                <TextBox Grid.Row="1" Name="txtLogBox" Background="Transparent" Foreground="#CBD5E1" BorderThickness="0" FontFamily="Consolas, Courier New, monospace" FontSize="12" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Padding="16,8,16,8" />
            </Grid>
        </Border>
    </Grid>
</Window>
